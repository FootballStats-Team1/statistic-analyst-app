<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Επιλογή ομάδας (logos σαν κουμπιά) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <ImageButton
            android:id="@+id/btnHomeTeam"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@color/palette_blue_4"
            android:contentDescription="Γηπεδούχος"
            android:padding="10dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnAwayTeam"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:background="@color/palette_blue_4"
            android:contentDescription="Φιλοξενούμενη"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectedTeam"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/playersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnSaveLineups"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_lineups"
        android:layout_marginTop="8dp" />
</LinearLayout>